# --- Обязательные ---

# Ключ доступа сообщества: Управление → Работа с API → Ключи доступа.
# Нужны права «Сообщения сообщества». От этого токена бот и говорит от лица группы.
VK_GROUP_TOKEN=vk1.a....

# Числовой id сообщества, без минуса. Виден в Управление → Работа с API,
# а также в адресе беседы: vk.ru/gim99620306/convo/... → 99620306
VK_GROUP_ID=123456789

# Беседа, куда уходит ежедневный дайджест. Открыть её от имени сообщества
# и взять число после convo: vk.ru/gim99620306/convo/2000000002 → 2000000002
# Короткий номер беседы (тут 2) тоже принимается.
VK_CHAT_ID=2000000002


# --- Необязательные (значения по умолчанию) ---

# Во сколько по местному времени уходит дайджест.
YARANIMKA_DAILY_AT=10:00

# Часовой пояс в часах от UTC: 4 — Тбилиси, 3 — Москва.
YARANIMKA_TZ_OFFSET=4

# Минимальная оценка на Shikimori, чтобы тайтл попал в дайджест.
# 0 — берём всё подряд, 6.5 — заметно чище.
YARANIMKA_MIN_SCORE=0

# Сколько строк максимум в одном дне дайджеста.
YARANIMKA_MAX_ITEMS=20

# Сколько новостей аниме показывать под списком серий. 0 убирает блок.
YARANIMKA_NEWS=3

# Сезонные напоминания: в последнюю неделю сезона — забрать завершившееся,
# в первые дни нового — пятёрка самых ожидаемых тайтлов. 0 убирает оба.
YARANIMKA_SEASON=1
YARANIMKA_SEASON_TOP=5

# Ссылки на русские раздачи: как только на AniLibria или Nyaa появляется
# озвучка либо субтитры, бот дописывает ссылку в утреннее сообщение.
# Второго сообщения он не отправляет никогда.
YARANIMKA_WATCH=1

# Как часто обходить торренты, в минутах. За обход уходит по одному запросу
# на площадку независимо от длины списка, но чаще четверти часа смысла нет.
YARANIMKA_WATCH_EVERY=30

# Сколько суток держать серию в списке. Дольше суток смысла мало:
# править сообщение ВКонтакте всё равно разрешает только сутки.
YARANIMKA_WATCH_DAYS=3

# Файл, где бот помнит отправленный дайджест и список слежения.
YARANIMKA_STATE_PATH=state.json

# Ничего не отправлять, только писать в лог.
YARANIMKA_DRY_RUN=0
